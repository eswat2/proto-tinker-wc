{
  "name": "proto-tinker-wc",
  "version": "0.1.266",
  "description": "prototype - simple demo built from Stencil & Tailwind",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/proto-tinker-wc/proto-tinker-wc.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "bump": "bumpp patch --commit --tag --push --yes",
    "release": "pnpm bump && pnpm build",
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently \"pnpm:twx --watch\" \"pnpm:start\"",
    "twx": "twx",
    "build": "pnpm twx; pnpm format; stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "echo --skip",
    "generate": "stencil generate",
    "spell": "cspell 'src/**/*.{ts,tsx,html,css,md}' ",
    "cc": "prettier --check src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@stencil/core": "4.44.2",
    "@stencil/store": "2.2.4"
  },
  "devDependencies": {
    "autoprefixer": "10.5.5",
    "bumpp": "12.3.0",
    "concurrently": "10.0.5",
    "cspell": "10.2.2",
    "eslint": "10.10.0",
    "only-allow": "1.2.2",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "proto-tailwindcss-clrs": "0.0.543",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "workbox-build": "7.4.1",
    "yoctocolors": "2.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eswat2/proto-tinker-wc.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
